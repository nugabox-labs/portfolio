# Notion integration token (Internal Integration Secret).
# 발급: https://www.notion.so/my-integrations 에서 인테그레이션 생성 후,
# 대상 데이터베이스(포트폴리오)에 해당 인테그레이션을 연결(Connect)해야 조회가 가능합니다.
NOTION_TOKEN=

# Notion 데이터베이스 ID ("포트폴리오" DB)
NOTION_DATABASE_ID=39faac4e32a580aa9f7fd2fd2a197b85

# Notion 데이터를 몇 초 동안 캐시할지 (기본 300초 = 5분)
NOTION_REVALIDATE_SECONDS=300
